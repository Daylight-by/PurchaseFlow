@page "{id:guid}"
@model PurchaseFlow.Web.Pages.Purchasing.DetailsModel
@using System.Globalization
@using System.Linq
@using PurchaseFlow.Purchasing

@{
    Layout = "/Pages/Shared/_PurchaseLayout.cshtml";
    var statusText = PurchaseFlow.Web.Pages.Purchasing.IndexModel.StatusText(Model.PurchaseRequest.Status);
    var selectedQuote = Model.PurchaseRequest.Quotes.FirstOrDefault(x => x.Id == Model.PurchaseRequest.SelectedQuoteId);
    var decision = Model.PurchaseRequest.Decision;
    var currentStatus = Model.PurchaseRequest.Status.ToString().ToLowerInvariant();
    var selectedMargin = decision.SelectedMarginPercent;
    ViewData["Title"] = "决策详情";
}

<div class="pf-page pf-detail-page">
    <nav class="pf-breadcrumb" aria-label="面包屑">
        <a class="pf-link" asp-page="/Purchasing/Index">采购需求</a>
        <span aria-hidden="true">/</span>
        <span>决策详情</span>
    </nav>

    <header class="pf-detail-hero pf-detail-hero-modern mt-3 mb-4">
        <div class="pf-detail-heading">
            <span class="pf-section-kicker">PURCHASE REQUEST · 决策页</span>
            <h1>@Model.PurchaseRequest.OrderReference</h1>
            <p class="pf-detail-description">@Model.PurchaseRequest.Description</p>
            <div class="pf-detail-meta">
                <span>销售金额 <strong>¥@Model.PurchaseRequest.SaleAmount.ToString("N2")</strong></span>
                <span>采购明细汇总 <strong>¥@Model.PurchaseRequest.Amount.ToString("N2")</strong> · @Model.PurchaseRequest.LineCount 条明细</span>
                <span>创建于 @Model.PurchaseRequest.CreationTime.ToString("yyyy-MM-dd HH:mm")</span>
            </div>
        </div>
        <div class="pf-detail-actions">
            <span class="pf-status pf-status-@currentStatus">@statusText</span>
            <a class="pf-button pf-button-secondary" asp-page="/Purchasing/Brief" asp-route-id="@Model.PurchaseRequest.Id">查看决策简报</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger pf-alert" role="alert">@Model.Error</div>
    }

    <section class="pf-panel pf-progress-panel mb-4" aria-labelledby="progress-title">
        <div class="pf-panel-heading">
            <div><span class="pf-section-kicker">WORKFLOW</span><h2 id="progress-title">流程进度</h2></div>
            <span class="pf-hint">当前状态：@statusText</span>
        </div>
        <ol class="pf-progress" aria-label="采购审批流程">
            <li class="@(Model.PurchaseRequest.Status is PurchaseRequestStatus.Draft or PurchaseRequestStatus.Returned ? "pf-progress-current" : "pf-progress-done")"><span class="pf-progress-index">1</span><strong>草稿</strong><small>建立需求与报价</small></li>
            <li class="@(Model.PurchaseRequest.Status == PurchaseRequestStatus.PendingReview ? "pf-progress-current" : Model.PurchaseRequest.Status == PurchaseRequestStatus.Approved ? "pf-progress-done" : "")"><span class="pf-progress-index">2</span><strong>待审核</strong><small>提交决策依据</small></li>
            <li class="@(Model.PurchaseRequest.Status == PurchaseRequestStatus.Approved ? "pf-progress-current pf-progress-done" : "")"><span class="pf-progress-index">3</span><strong>已批准</strong><small>方案进入已批准状态</small></li>
            <li class="@(Model.PurchaseRequest.PurchaseOrder is not null ? "pf-progress-current pf-progress-done" : "")"><span class="pf-progress-index">4</span><strong>已下采购单</strong><small>按已选报价生成订单</small></li>
        </ol>
        @if (Model.PurchaseRequest.Status == PurchaseRequestStatus.Returned)
        {
            <p class="pf-progress-note">已退回，补充后重新提交</p>
        }
    </section>

    <section class="pf-panel mb-4" aria-labelledby="lines-title">
        <div class="pf-panel-heading">
            <div><span class="pf-section-kicker">PURCHASE LINES</span><h2 id="lines-title">采购明细 <small>@Model.PurchaseRequest.Lines.Count 条</small></h2></div>
            <span class="pf-hint">需求金额由明细汇总，不单独手填</span>
        </div>
        @if (Model.PurchaseRequest.Lines.Count == 0)
        {
            <div class="pf-empty-state pf-empty-state-compact"><strong>还没有采购明细</strong><span>补充物料、规格、数量与单价后，需求金额会自动汇总。</span></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table pf-table pf-line-table align-middle mb-0">
                    <thead><tr><th>物料</th><th>规格</th><th>数量</th><th>单价</th><th>小计</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.PurchaseRequest.Lines)
                    {
                        <tr>
                            <td data-label="物料"><strong>@line.ItemName</strong></td>
                            <td data-label="规格" class="pf-muted">@(string.IsNullOrWhiteSpace(line.Specification) ? "—" : line.Specification)</td>
                            <td data-label="数量">@line.Quantity.ToString("0.###")</td>
                            <td data-label="单价" class="pf-money">¥@line.UnitPrice.ToString("N2")</td>
                            <td data-label="小计" class="pf-money pf-line-subtotal">¥@line.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4">采购明细汇总</td>
                            <td><span class="pf-line-total">¥@Model.PurchaseRequest.Amount.ToString("N2")</span></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <section class="pf-panel pf-decision-overview mb-4" aria-labelledby="decision-title">
        <div class="pf-panel-heading">
            <div><span class="pf-section-kicker">DECISION SNAPSHOT</span><h2 id="decision-title">决策概览</h2></div>
            <span class="pf-hint">毛利 = 销售金额 − 选中采购报价；不含税费、物流及其他成本</span>
        </div>
        <div class="pf-metric-grid">
            <div class="pf-metric"><span>预计销售金额</span><strong>¥@Model.PurchaseRequest.SaleAmount.ToString("N2")</strong><small>需求中录入的销售金额</small></div>
            <div class="pf-metric"><span>选中采购额</span><strong>@(Model.PurchaseRequest.SelectedQuoteAmount.HasValue ? "¥" + Model.PurchaseRequest.SelectedQuoteAmount.Value.ToString("N2") : "待选择")</strong><small>@(selectedQuote?.SupplierName ?? "尚未选定供应商")</small></div>
            <div class="pf-metric @(Model.PurchaseRequest.ExpectedGrossProfit < 0 ? "pf-metric-negative" : "pf-metric-accent")"><span>预计毛利</span><strong>@(Model.PurchaseRequest.ExpectedGrossProfit.HasValue ? "¥" + Model.PurchaseRequest.ExpectedGrossProfit.Value.ToString("N2") : "待计算")</strong><small>当前选择的方案</small></div>
            <div class="pf-metric @(selectedMargin < 0 ? "pf-metric-negative" : "")"><span>预计毛利率</span><strong>@(selectedMargin.HasValue ? selectedMargin.Value.ToString("N2") + "%" : "待计算")</strong><small>预计毛利 ÷ 销售金额</small></div>
        </div>

        @if (selectedQuote is not null)
        {
            <div class="pf-decision-note mt-3">
                <div class="pf-decision-note-title"><strong>当前选择：@selectedQuote.SupplierName</strong><span class="pf-status pf-status-approved">已选方案</span></div>
                <p class="mb-1">选择理由：@(string.IsNullOrWhiteSpace(Model.PurchaseRequest.SelectionReason) ? "未填写" : Model.PurchaseRequest.SelectionReason)</p>
                @if (Model.PurchaseRequest.SelectedCostPremiumToLowest.HasValue)
                {
                    <p class="pf-muted mb-0">
                        相对最低价 @(Model.PurchaseRequest.SelectedCostPremiumToLowest.Value == 0 ? "持平" : "高 ¥" + Model.PurchaseRequest.SelectedCostPremiumToLowest.Value.ToString("N2"))；
                        @if (Model.PurchaseRequest.SelectedDeliveryDaysComparedWithLowest.HasValue && Model.PurchaseRequest.SelectedDeliveryDaysComparedWithLowest.Value < 0)
                        {
                            <span>交付提前 @(-Model.PurchaseRequest.SelectedDeliveryDaysComparedWithLowest.Value) 天。</span>
                        }
                        else if (Model.PurchaseRequest.SelectedDeliveryDaysComparedWithLowest.HasValue && Model.PurchaseRequest.SelectedDeliveryDaysComparedWithLowest.Value > 0)
                        {
                            <span>交付延后 @Model.PurchaseRequest.SelectedDeliveryDaysComparedWithLowest.Value 天。</span>
                        }
                        else
                        {
                            <span>交付天数相同。</span>
                        }
                    </p>
                }
            </div>
        }
        else
        {
            <div class="pf-empty-state pf-empty-state-compact"><strong>尚未选定供应商</strong><span>先录入报价，再填写选择理由并选定方案。</span></div>
        }
    </section>

    <section class="pf-panel pf-readiness mb-4" aria-labelledby="readiness-title">
        <div class="pf-panel-heading">
            <div><span class="pf-section-kicker">SUBMISSION CHECK</span><h2 id="readiness-title">提交准备清单</h2></div>
            <div class="pf-readiness-heading"><span class="pf-readiness-state @(decision.IsReadyToSubmit ? "pf-ready" : "pf-not-ready")">@(decision.IsReadyToSubmit ? "报价与理由已齐备" : "仍需补充信息")</span><span class="pf-hint">是否可提交还取决于当前状态与操作权限</span></div>
        </div>
        @if (decision.Checks.Count > 0)
        {
            <div class="pf-check-list">
                @foreach (var check in decision.Checks)
                {
                    <div class="pf-check-item @(check.IsComplete ? "pf-check-complete" : "pf-check-incomplete")"><span class="pf-check-icon" aria-hidden="true">@(check.IsComplete ? "✓" : "○")</span><span>@check.Label</span></div>
                }
            </div>
        }
        else
        {
            <div class="pf-empty-state pf-empty-state-compact"><span>当前没有可展示的准备清单。</span></div>
        }
        @if (decision.Warnings.Count > 0)
        {
            <div class="pf-warning-list" role="status"><strong>需要留意</strong>
                @foreach (var warning in decision.Warnings)
                {
                    <div class="pf-warning-item"><span aria-hidden="true">!</span>@warning.Message</div>
                }
                <small>这些比较提示供审核参考，请在选择理由中补充质量或服务差异。</small>
            </div>
        }
    </section>

    <section class="pf-panel mb-4" aria-labelledby="quotes-title">
        <div class="pf-panel-heading"><div><span class="pf-section-kicker">QUOTATION COMPARISON</span><h2 id="quotes-title">报价比较 <small>@Model.PurchaseRequest.Quotes.Count 家供应商</small></h2></div><span class="pf-hint">最低价、最快交期和已选方案均已标记；每个供应商行下方可核对逐项报价与明细合计</span></div>
        @if (Model.PurchaseRequest.Quotes.Count == 0)
        {
            <div class="pf-empty-state"><strong>还没有供应商报价</strong><span>录入至少两家报价，才能比较不同采购方案。</span></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table pf-table pf-quote-table align-middle mb-0">
                    <thead><tr><th>供应商 / 备注</th><th>采购报价</th><th>交付</th><th>预计毛利</th><th>相对最低价</th><th>方案标签</th><th>操作</th></tr></thead>
                    <tbody>
                    @foreach (var quote in Model.PurchaseRequest.Quotes)
                    {
                        var isSelected = Model.PurchaseRequest.SelectedQuoteId == quote.Id;
                        var isCheapest = decision.CheapestQuoteIds.Contains(quote.Id) || quote.CostPremiumToLowest == 0;
                        var isFastest = decision.FastestQuoteIds.Contains(quote.Id);
                        var isDominated = decision.DominatedQuoteIds.Contains(quote.Id);
                        <tr class="@(isSelected ? "pf-quote-selected" : "") @(isDominated ? "pf-quote-dominated" : "")">
                            <td data-label="供应商 / 备注">
                                <strong>@quote.SupplierName</strong>
                                <span class="pf-row-subtitle">@(string.IsNullOrWhiteSpace(quote.Note) ? "无补充说明" : quote.Note)</span>
                                @if (quote.SupplierId.HasValue)
                                {
                                    @* 第二轮第 1 批：报价关联了供应商档案时给出提示；档案已停用则提示不可再用于新报价。 *@
                                    <span class="pf-row-subtitle">@(Model.IsKnownSupplier(quote.SupplierId) ? "已关联供应商档案" : "关联的供应商档案已停用")</span>
                                }
                            </td>
                            <td data-label="采购报价" class="pf-money">¥@quote.Amount.ToString("N2")</td>
                            <td data-label="交付">@quote.DeliveryDays 天</td>
                            <td data-label="预计毛利" class="pf-money @(quote.ExpectedGrossProfit < 0 ? "pf-money-negative" : "")">¥@quote.ExpectedGrossProfit.ToString("N2")</td>
                            <td data-label="相对最低价" class="pf-muted">@(quote.CostPremiumToLowest == 0 ? "最低价" : "+ ¥" + quote.CostPremiumToLowest.ToString("N2"))</td>
                            <td data-label="方案标签"><div class="pf-quote-tags">
                                @if (isSelected) { <span class="pf-quote-tag pf-quote-tag-selected">已选择</span> }
                                @if (isCheapest) { <span class="pf-quote-tag pf-quote-tag-cheapest">最低价</span> }
                                @if (isFastest) { <span class="pf-quote-tag pf-quote-tag-fastest">最快交期</span> }
                                @if (isDominated) { <span class="pf-quote-tag pf-quote-tag-muted">价期均不占优</span> }
                            </div></td>
                            <td data-label="操作" class="@( !Model.CanEdit && !isSelected ? "pf-empty-action" : "")">
                                @if (Model.CanEdit)
                                {
                                    <form method="post" asp-page-handler="Select" asp-route-id="@Model.PurchaseRequest.Id" class="pf-quote-select-form">
                                        <input type="hidden" name="quoteId" value="@quote.Id" />
                                        <input class="form-control form-control-sm" name="reason" aria-label="选择 @quote.SupplierName 的理由" placeholder="选择理由" value="@(isSelected ? Model.PurchaseRequest.SelectionReason : "")" maxlength="500" required />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">@(isSelected ? "更新理由" : "选择")</button>
                                    </form>
                                    <form method="post" asp-page-handler="DeleteQuote" asp-route-id="@Model.PurchaseRequest.Id" class="pf-quote-delete-form"><input type="hidden" name="quoteId" value="@quote.Id" /><button class="btn btn-sm btn-link text-danger p-0" type="submit">删除报价</button></form>
                                }
                                else if (isSelected)
                                {
                                    <span class="pf-status pf-status-approved">已选择</span>
                                }
                            </td>
                        </tr>
                        @* P0-1：每个供应商行下方展示该报价的逐项明细，并核对“报价合计 = 明细合计”。
                           历史报价可能没有逐项明细（迁移前数据），这里显式提示，而不是假装一致。 *@
                        var quoteLineSum = quote.Lines.Sum(x => x.Subtotal);
                        var quoteTotalConsistent = quote.Lines.Count > 0 && Math.Abs(quoteLineSum - quote.Amount) < 0.005m;
                        <tr class="pf-quote-detail-row">
                            <td colspan="7">
                                <details class="pf-quote-detail" open>
                                    <summary>逐项报价明细<span class="pf-muted">（@quote.Lines.Count 项）</span></summary>
                                    @if (quote.Lines.Count == 0)
                                    {
                                        <p class="pf-muted mb-0">该报价没有逐项明细（可能是迁移前的历史报价），无法核对“总额 = 明细合计”。</p>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table pf-line-table pf-quote-detail-table align-middle mb-0">
                                                <thead><tr><th>物料</th><th>规格</th><th>数量</th><th>报价单价</th><th>小计</th></tr></thead>
                                                <tbody>
                                                @foreach (var quoteLine in quote.Lines)
                                                {
                                                    <tr>
                                                        <td data-label="物料"><strong>@quoteLine.ItemName</strong></td>
                                                        <td data-label="规格" class="pf-muted">@(string.IsNullOrWhiteSpace(quoteLine.Specification) ? "—" : quoteLine.Specification)</td>
                                                        <td data-label="数量">@quoteLine.Quantity.ToString("0.###")</td>
                                                        <td data-label="报价单价" class="pf-money">¥@quoteLine.UnitPrice.ToString("N2")</td>
                                                        <td data-label="小计" class="pf-money pf-line-subtotal">¥@quoteLine.Subtotal.ToString("N2")</td>
                                                    </tr>
                                                }
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <td colspan="4">报价合计 / 明细合计</td>
                                                        <td>
                                                            <span class="pf-line-total">¥@quote.Amount.ToString("N2")</span>
                                                            <span class="pf-muted">/ ¥@quoteLineSum.ToString("N2")</span>
                                                            @if (quoteTotalConsistent)
                                                            {
                                                                <span class="pf-quote-consistency pf-quote-consistency-ok">✓ 一致</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="pf-quote-consistency pf-quote-consistency-bad">⚠ 不一致（差 ¥@Math.Abs(quote.Amount - quoteLineSum).ToString("N2")）</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    }
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.CanEdit)
        {
            @* P0-1：报价从“手填总额”改为“按当前需求明细逐项录入报价单价”，
               页面只提交需求明细 Id 与报价单价，报价总额由后端按明细小计汇总。 *@
            <form method="post" asp-page-handler="AddQuote" asp-route-id="@Model.PurchaseRequest.Id" class="pf-add-quote-form mt-3" data-quote-editor>
                <div class="row g-2 align-items-end">
                    @* 第二轮第 1 批：优先从供应商档案选择（显示“编码 - 名称”）；不选则沿用旧的手工名称录入。
                       选中档案后由 JS 把名称填入文本框并写隐藏 SupplierId，名称快照最终由服务端按档案覆盖。 *@
                    <div class="col-md-3">
                        <label class="form-label" for="supplierIdSelect">供应商档案</label>
                        <select class="form-select" id="supplierIdSelect" data-supplier-select aria-label="选择供应商档案（可选）">
                            <option value="">不选档案（手工填写名称）</option>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <option value="@supplier.Id" data-supplier-name="@supplier.Name">@supplier.Code - @supplier.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="supplierName">供应商</label>
                        <input class="form-control" id="supplierName" data-supplier-name-input name="supplierName" placeholder="供应商名称（选择档案后自动填入）" maxlength="100" required />
                        <input type="hidden" name="supplierId" data-supplier-id value="" />
                    </div>
                    <div class="col-md-2"><label class="form-label" for="deliveryDays">交付天数</label><input class="form-control" id="deliveryDays" name="deliveryDays" type="number" min="0" required /></div>
                    <div class="col-md-2"><label class="form-label" for="note">备注</label><input class="form-control" id="note" name="note" maxlength="500" placeholder="差异" /></div>
                    <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">添加报价</button></div>
                </div>

                @if (Model.PurchaseRequest.Lines.Count == 0)
                {
                    <p class="pf-progress-note mb-0 mt-3">还没有采购明细，无法按明细逐项报价。请先在下方“编辑采购需求”中补充明细。</p>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table pf-line-table pf-quote-input-table align-middle mb-0">
                            <thead><tr><th>物料</th><th>规格</th><th>数量</th><th>报价单价（元）</th><th>小计</th></tr></thead>
                            <tbody>
                            @for (var i = 0; i < Model.PurchaseRequest.Lines.Count; i++)
                            {
                                var line = Model.PurchaseRequest.Lines[i];
                                // P0-1：表单校验失败回显时 QuoteLines 可能少于当前明细，按索引兜底避免越界。
                                var quoteLine = i < Model.QuoteLines.Count ? Model.QuoteLines[i] : null;
                                <tr data-quote-line data-quote-quantity="@line.Quantity.ToString(CultureInfo.InvariantCulture)">
                                    <td data-label="物料">
                                        <input type="hidden" name="QuoteLines[@i].RequestLineId" value="@line.Id" />
                                        <strong>@line.ItemName</strong>
                                    </td>
                                    <td data-label="规格" class="pf-muted">@(string.IsNullOrWhiteSpace(line.Specification) ? "—" : line.Specification)</td>
                                    <td data-label="数量">@line.Quantity.ToString("0.###")</td>
                                    <td data-label="报价单价"><input class="form-control form-control-sm" data-quote-price name="QuoteLines[@i].UnitPrice" value="@(quoteLine is not null && quoteLine.UnitPrice > 0 ? quoteLine.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture) : string.Empty)" type="number" min="0" step="0.01" placeholder="0.00" required aria-label="@line.ItemName 的报价单价" /></td>
                                    <td data-label="小计"><span class="pf-line-subtotal" data-quote-subtotal>¥0.00</span></td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3">报价合计（按明细自动汇总，不需要手填总额）</td>
                                    <td colspan="2"><span class="pf-line-total" data-quote-total>¥0.00</span></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <p class="pf-hint mb-0 mt-2">每条需求明细都要填写本供应商的报价单价；报价合计按“数量 × 报价单价”逐项汇总，与后端落库总额同口径。</p>
                }
            </form>
        }
    </section>

    @if (Model.PurchaseRequest.PurchaseOrder is { } order)
    {
        <section class="pf-panel mb-4" aria-labelledby="order-title">
            <div class="pf-panel-heading">
                <div><span class="pf-section-kicker">PURCHASE ORDER</span><h2 id="order-title">采购订单 <small>@order.OrderNumber</small></h2></div>
                <span class="pf-hint">审批通过后按已选报价自动生成，可直接发给供应商</span>
            </div>
            <div class="pf-metric-grid mb-3">
                <div class="pf-metric"><span>供应商</span><strong style="font-size:18px">@order.SupplierName</strong><small>@(order.SupplierId.HasValue ? (Model.IsKnownSupplier(order.SupplierId) ? "来自已选报价 · 已关联供应商档案" : "来自已选报价 · 关联档案已停用") : "来自已选报价（手工名称）")</small></div>
                <div class="pf-metric"><span>订单金额</span><strong>¥@order.Amount.ToString("N2")</strong><small>以选中报价为准</small></div>
                <div class="pf-metric"><span>交付</span><strong>@order.DeliveryDays 天</strong><small>供应商承诺交期</small></div>
                <div class="pf-metric"><span>订单状态</span><strong style="font-size:18px">@(Model.PurchaseOrderReceipts is { } receiptSummary ? PurchaseFlow.Web.Pages.Purchasing.DetailsModel.ReceiptStatusText(receiptSummary) : PurchaseFlow.Web.Pages.Purchasing.DetailsModel.OrderStatusText(order.Status))</strong><small>生成于 @order.CreationTime.ToString("yyyy-MM-dd HH:mm")</small></div>
            </div>
            <div class="table-responsive">
                <table class="table pf-table pf-line-table align-middle mb-0">
                    <thead><tr><th>物料</th><th>规格</th><th>数量</th><th>单价</th><th>小计</th></tr></thead>
                    <tbody>
                    @foreach (var line in order.Lines)
                    {
                        <tr>
                            <td data-label="物料"><strong>@line.ItemName</strong></td>
                            <td data-label="规格" class="pf-muted">@(string.IsNullOrWhiteSpace(line.Specification) ? "—" : line.Specification)</td>
                            <td data-label="数量">@line.Quantity.ToString("0.###")</td>
                            <td data-label="单价" class="pf-money">¥@line.UnitPrice.ToString("N2")</td>
                            <td data-label="小计" class="pf-money pf-line-subtotal">¥@line.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.CanViewReceipts && Model.PurchaseOrderReceipts is { } receiptState)
            {
                var receiptStatusText = PurchaseFlow.Web.Pages.Purchasing.DetailsModel.ReceiptStatusText(receiptState);
                <div class="pf-receipt-panel mt-4" aria-labelledby="receipt-title">
                    <div class="pf-panel-heading">
                        <div><span class="pf-section-kicker">GOODS RECEIPT</span><h3 id="receipt-title">分批收货</h3></div>
                        <span class="pf-status pf-status-@(receiptState.IsFullyReceived ? "approved" : receiptState.IsPartiallyReceived ? "pending" : "draft")">@receiptStatusText</span>
                    </div>
                    <div class="pf-metric-grid mb-3">
                        <div class="pf-metric"><span>订购总量</span><strong>@receiptState.Lines.Sum(x => x.OrderedQuantity).ToString("0.###")</strong><small>当前 PO 明细合计</small></div>
                        <div class="pf-metric"><span>累计已收</span><strong>@receiptState.Lines.Sum(x => x.ReceivedQuantity).ToString("0.###")</strong><small>已提交收货单合计</small></div>
                        <div class="pf-metric"><span>剩余待收</span><strong>@receiptState.Lines.Sum(x => x.RemainingQuantity).ToString("0.###")</strong><small>不能超过订单剩余量</small></div>
                    </div>

                    <div class="table-responsive">
                        <table class="table pf-table pf-line-table align-middle mb-0">
                            <thead><tr><th>物料</th><th>订购</th><th>累计已收</th><th>剩余</th><th>本次收货</th></tr></thead>
                            <tbody>
                            @for (var i = 0; i < Model.ReceiptLines.Count; i++)
                            {
                                var input = Model.ReceiptLines[i];
                                var receiptLine = receiptState.Lines.FirstOrDefault(x => x.PurchaseOrderLineId == input.PurchaseOrderLineId);
                                if (receiptLine is null) { continue; }
                                <tr>
                                    <td data-label="物料"><strong>@receiptLine.ItemName</strong><span class="pf-row-subtitle">@(string.IsNullOrWhiteSpace(receiptLine.Specification) ? "无规格" : receiptLine.Specification)</span></td>
                                    <td data-label="订购">@receiptLine.OrderedQuantity.ToString("0.###")</td>
                                    <td data-label="累计已收">@receiptLine.ReceivedQuantity.ToString("0.###")</td>
                                    <td data-label="剩余">@receiptLine.RemainingQuantity.ToString("0.###")</td>
                                    <td data-label="本次收货">
                                        <input type="hidden" name="ReceiptLines[@i].PurchaseOrderLineId" value="@input.PurchaseOrderLineId" />
                                        @if (Model.CanRegisterReceipts && receiptLine.RemainingQuantity > 0)
                                        {
                                            <div class="d-flex gap-2 align-items-center">
                                                <input class="form-check-input" type="checkbox" name="ReceiptLines[@i].Selected" value="true" @(input.Selected ? "checked" : null) aria-label="选择 @receiptLine.ItemName" />
                                                <input class="form-control form-control-sm" name="ReceiptLines[@i].Quantity" value="@input.Quantity" type="number" min="0.001" max="@receiptLine.RemainingQuantity" step="0.001" aria-label="@receiptLine.ItemName 本次收货数量" />
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="pf-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.CanRegisterReceipts && !receiptState.IsFullyReceived)
                    {
                        <form method="post" asp-page-handler="Receive" asp-route-id="@Model.PurchaseRequest.Id" class="row g-2 align-items-end mt-3">
                            <div class="col-md-3"><label class="form-label" for="receiptDate">业务收货日期</label><input class="form-control" id="receiptDate" name="ReceiptDate" value="@Model.ReceiptDate.ToString("yyyy-MM-dd")" type="date" required /></div>
                            <div class="col-md-3"><label class="form-label" for="receiptKey">请求幂等标识</label><input class="form-control" id="receiptKey" name="ReceiptIdempotencyKey" value="@Model.ReceiptIdempotencyKey" maxlength="128" required /></div>
                            <div class="col-md-4"><label class="form-label" for="receiptNote">备注</label><input class="form-control" id="receiptNote" name="ReceiptNote" value="@Model.ReceiptNote" maxlength="500" /></div>
                            <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">提交收货</button></div>
                        </form>
                    }
                    else if (receiptState.IsFullyReceived)
                    {
                        <p class="pf-progress-note mb-0 mt-3">所有订单明细均已收齐，已提交收货记录不可编辑或删除。</p>
                    }
                    else
                    {
                        <p class="pf-progress-note mb-0 mt-3">当前账号只有收货查看权限，不能登记收货。</p>
                    }

                    <div class="mt-4">
                        <h4 class="h6">收货记录</h4>
                        @if (receiptState.Receipts.Count == 0)
                        {
                            <div class="pf-empty-state pf-empty-state-compact"><span>暂无已提交收货记录。</span></div>
                        }
                        else
                        {
                            <div class="pf-timeline">
                            @foreach (var receipt in receiptState.Receipts)
                            {
                                <div class="pf-timeline-item mb-3">
                                    <strong>@receipt.ReceiptDate.ToString("yyyy-MM-dd")</strong>
                                    <span class="pf-muted">提交于 @receipt.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · 操作人 @(receipt.CreatorId?.ToString() ?? "系统")</span>
                                    @if (!string.IsNullOrWhiteSpace(receipt.Note)) { <p class="mb-1">@receipt.Note</p> }
                                    <ul class="mb-0">
                                    @foreach (var receiptLine in receipt.Lines)
                                    {
                                        <li>@receiptLine.ItemName：@receiptLine.Quantity.ToString("0.###")</li>
                                    }
                                    </ul>
                                </div>
                            }
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    }

    <section class="pf-panel pf-decision-lab mb-4" data-decision-lab aria-labelledby="decision-lab-title">
        <div class="pf-panel-heading"><div><span class="pf-section-kicker">DECISION LAB</span><h2 id="decision-lab-title">决策实验台</h2></div><span class="pf-hint">调整比较偏好，不会改变已选方案</span></div>
        <p class="pf-lab-intro">拖动权重，观察价格和交期如何影响相对评分。分数只反映当前报价集合的相对位置，不能替代业务判断。</p>
        <div class="pf-lab-controls">
            <label class="pf-lab-slider-label" for="decision-lab-price-weight"><span>价格权重 <strong data-lab-price-weight-value>70</strong>%</span><input id="decision-lab-price-weight" type="range" min="0" max="100" value="70" data-lab-price-weight /></label>
            <span class="pf-lab-weight-separator" aria-hidden="true">+</span>
            <div class="pf-lab-delivery-weight">交期权重 <strong data-lab-delivery-weight-value>30</strong>%</div>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-lab-reset>恢复 70 / 30</button>
        </div>
        <div class="pf-lab-quotes" aria-hidden="true">
            @foreach (var quote in Model.PurchaseRequest.Quotes)
            {
                <span hidden data-lab-quote data-quote-id="@quote.Id" data-amount="@quote.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-days="@quote.DeliveryDays" data-supplier="@quote.SupplierName"></span>
            }
        </div>
        <div class="pf-lab-results" data-lab-results aria-live="polite">
            @if (Model.PurchaseRequest.Quotes.Count < 2)
            {
                <div class="pf-empty-state pf-empty-state-compact"><strong>还不能进行有意义的相对比较</strong><span>请先录入至少两家供应商方案，实验台会按当前报价计算相对成本与交期分数。</span></div>
            }
            else
            {
                <div class="pf-lab-placeholder">正在根据报价计算方案评分…</div>
            }
        </div>
        <noscript><p class="pf-no-script">启用 JavaScript 后可以调整权重；报价表、选择与审核功能仍可使用。</p></noscript>
    </section>

    @if (Model.CanEdit)
    {
        <details class="pf-panel pf-edit-details mb-4" open>
            <summary><span><span class="pf-section-kicker">REQUEST DETAILS</span><strong>编辑采购需求</strong></span><span class="pf-hint">仅草稿或已退回需求可以修改</span></summary>
            <form method="post" asp-page-handler="Update" asp-route-id="@Model.PurchaseRequest.Id" class="pf-edit-form">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3"><label class="form-label" for="orderReference">销售单号</label><input class="form-control" id="orderReference" name="OrderReference" value="@Model.OrderReference" maxlength="64" required /></div>
                    <div class="col-md-5"><label class="form-label" for="description">需求说明</label><input class="form-control" id="description" name="Description" value="@Model.Description" maxlength="500" required /></div>
                    <div class="col-md-2"><label class="form-label" for="saleAmount">销售金额（元）</label><input class="form-control" id="saleAmount" name="SaleAmount" value="@Model.SaleAmount" type="number" min="0.01" step="0.01" required /></div>
                    <div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="submit">保存修改</button></div>
                </div>
                @* 第二轮第 1 批：编辑采购需求时同样可以通过「物料档案」下拉规范明细录入。 *@
                @await Html.PartialAsync("_LineEditor", new LineEditorModel
                {
                    Prefix = "Lines",
                    Rows = Model.Lines,
                    Materials = Model.Materials
                })
            </form>
        </details>
    }

    @if (Model.CanEdit)
    {
        <section class="pf-panel pf-submit-panel mb-4" aria-labelledby="submit-title"><div><span class="pf-section-kicker">NEXT ACTION</span><h2 id="submit-title">提交审核</h2><p class="pf-muted mb-0">确认报价和选择理由后提交。提交后内容将锁定，等待审核。</p></div><form method="post" asp-page-handler="Submit" asp-route-id="@Model.PurchaseRequest.Id"><button class="btn pf-primary" type="submit">提交审核 →</button></form></section>
    }

    @if (Model.CanReview)
    {
        <section class="pf-panel mb-4" aria-labelledby="review-title">
            <div class="pf-panel-heading"><div><span class="pf-section-kicker">REVIEW</span><h2 id="review-title">审核决策</h2></div><span class="pf-hint">核对报价、交期、选价理由和预计毛利</span></div>
            <form method="post" asp-page-handler="Approve" asp-route-id="@Model.PurchaseRequest.Id" class="row g-2 mb-3"><div class="col-md-9"><input class="form-control" name="comment" aria-label="批准意见" placeholder="批准意见（可选）" maxlength="500" /></div><div class="col-md-3"><button class="btn btn-success w-100" type="submit">批准需求</button></div></form>
            <form method="post" asp-page-handler="Return" asp-route-id="@Model.PurchaseRequest.Id" class="row g-2"><div class="col-md-9"><input class="form-control" name="comment" aria-label="退回原因" placeholder="退回原因（必填）" maxlength="500" required /></div><div class="col-md-3"><button class="btn btn-outline-danger w-100" type="submit">退回修改</button></div></form>
        </section>
    }

    <section class="pf-panel" aria-labelledby="history-title">
        <div class="pf-panel-heading"><div><span class="pf-section-kicker">AUDIT TRAIL</span><h2 id="history-title">操作时间线</h2></div><span class="pf-hint">时间按服务器所在地时区显示</span></div>
        <ol class="pf-timeline">
            @foreach (var item in Model.PurchaseRequest.History)
            {
                <li><time datetime="@item.OccurredAtUtc.ToString("O")">@item.OccurredAtUtc.ToLocalTime().ToString("MM-dd HH:mm")</time><div><strong>@PurchaseFlow.Web.Pages.Purchasing.DetailsModel.ActionText(item.Action)</strong><p>@item.Comment</p><small class="pf-muted">操作人：@item.ActorName</small></div></li>
            }
            @if (Model.PurchaseRequest.History.Count == 0) { <li><span class="pf-muted">暂无操作记录</span></li> }
        </ol>
    </section>
</div>
